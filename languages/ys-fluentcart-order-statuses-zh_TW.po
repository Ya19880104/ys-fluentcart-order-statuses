#. Plugin Name of the plugin
#: ys-fluentcart-order-statuses.php
msgid "YS FluentCart Order Statuses"
msgstr "YS FluentCart Order Statuses"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: ys-fluentcart-order-statuses.php
msgid "https://yangsheep.com.tw"
msgstr "https://yangsheep.com.tw"

#. Description of the plugin
#: ys-fluentcart-order-statuses.php
msgid "Custom order and shipping statuses for FluentCart — add your own workflow states (with colours, payment conditions and a \"keep this status after payment\" guard), and rename the built-in ones. Nothing in FluentCart core is patched."
msgstr "FluentCart 的自訂訂單狀態與出貨狀態——新增自己的流程狀態（可設顏色、付款條件，以及「付款後保留此狀態」的保護），也能改內建狀態的名稱。完全不修改 FluentCart 核心。"

#. Author of the plugin
#: ys-fluentcart-order-statuses.php
msgid "YANGSHEEP DESIGN"
msgstr "YANGSHEEP DESIGN"

